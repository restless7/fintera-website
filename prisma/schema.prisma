/// Intento de vinculación de cuenta Clerk a cliente con desafío seguro y anti-fuga
model CustomerAccountLinkAttempt {
  id                    String              @id @default(uuid())
  clerkUserId           String              @map("clerk_user_id")
  clientId              String?             @map("client_id")
  documentType          String              @map("document_type")
  documentNumber        String              @map("document_number")
  hashedVerifier        String              @map("hashed_verifier") // SHA-256 del OTP/challenge
