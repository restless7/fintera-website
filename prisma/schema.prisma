/// Sobre cifrado de entrega temporal de OTP (AES-256-GCM) para canales de notificación
model OtpDeliveryEnvelope {
  id                 String          @id @default(uuid())
  challengeId        String          @unique @map("challenge_id")
  encryptedOtp       String          @map("encrypted_otp") // Ciphertext cifrado AES-256-GCM
  targetMasked       String          @map("target_masked") // e.g. +57 *** *** 4589
  channel            String          // "LOCAL_SINK_SMS" | "LOCAL_SINK_WHATSAPP"
  status             String          @default("PENDING") // PENDING | DELIVERED_LOCAL | EXPIRED | CONSUMED
  expiresAt          DateTime        @map("expires_at")
  consumedAt         DateTime?       @map("consumed_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([challengeId])
  @@index([status, expiresAt])
  @@map("otp_delivery_envelopes")
}

/// Registro durable de procesamiento idempotente por consumidor y evento
model OutboxConsumerReceipt {
  id                 String          @id @default(uuid())
  consumerName       String          @map("consumer_name")
  eventId            String          @map("event_id")
  status             String          @default("SUCCESS") // SUCCESS | FAILED
  resultSummary      String?         @map("result_summary")
  processedAt        DateTime        @default(now()) @map("processed_at")

  @@unique([consumerName, eventId])
  @@index([consumerName])
  @@index([eventId])
  @@map("outbox_consumer_receipts")
}

/// Registro de auditoría de notificaciones operativas (solo proyecciones públicas redactadas)
model NotificationDispatchLog {
  id                 String          @id @default(uuid())
  recipientType      String          @map("recipient_type") // "CLIENT" | "ADVISOR" | "SUPERVISOR"
  recipientId        String          @map("recipient_id")
  channel            String          // "LOCAL_SINK_SMS" | "LOCAL_SINK_WHATSAPP" | "LOCAL_SINK_EMAIL" | "INTERNAL_CRM_ALERT"
  templateCode       String          @map("template_code")
  title              String
  content            String          // Solo contenido público autorizado
  status             String          @default("CAPTURED_LOCAL") // "CAPTURED_LOCAL" | "QUEUED" | "FAILED"
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([recipientId])
  @@index([channel])
  @@index([createdAt])
  @@map("notification_dispatch_logs")
}

/// Tarea de seguimiento y escalación automática de SLAs bancarios y documentos
model SlaAutomationTask {
  id                 String          @id @default(uuid())
  ruleCode           String          @map("rule_code") // "BANK_STAGE_OVERDUE" | "INACTIVE_CASE_ALERT" | "DOCUMENT_EXPIRING_WARNING" | "CUSTOMER_MESSAGE_PENDING"
  dedupKey           String          @unique @map("dedup_key") // (ruleCode, resourceId, policyVersion, evaluationWindow)
  applicationId      String          @map("application_id")
  bankApplicationId  String?         @map("bank_application_id")
  severity           String          // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  title              String
  description        String
  assignedRole       String          @map("assigned_role")
  assignedUserId     String?         @map("assigned_user_id")
  status             String          @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "DISMISSED"
  actionRequired     String?         @map("action_required")
  resolvedAt         DateTime?       @map("resolved_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([ruleCode])
  @@index([applicationId])
  @@index([assignedUserId, status])
  @@map("sla_automation_tasks")
}

/// Agregación analítica diaria del embudo comercial (Read-Model OLAP aislado)
