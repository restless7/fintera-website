/// Asignación granular de permisos de acceso a cliente, solicitud o cotitular
model CustomerAccessGrant {
  id                    String              @id @default(uuid())
  clerkUserId           String              @map("clerk_user_id")
  clientId              String              @map("client_id")
  client                Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  applicationId         String?             @map("application_id")
  application           CrmCreditApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
